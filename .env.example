# Copy to `.env` and fill in. `.env` is gitignored. NEVER commit real keys.

# --- NASA APIs ---
# DONKI space-weather API. DEMO_KEY works but is heavily rate limited (the API reported
# X-RateLimit-Limit: 10 when probed). Responses are cached on disk; get a free key to lift the cap.
# Get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# --- AI Investigation agent (optional) ---
# Without a key the platform uses the deterministic offline report generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Database ---
# Local default is SQLite (no services needed). Compose/CI use Postgres + TimescaleDB.
DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.sqlite
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# --- Platform security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-real-deployments
# HMAC key used to authenticate SIMULATED spacecraft frames (synthetic; not a real key).
FRAME_HMAC_KEY=change-me-simulated-frame-key
CORS_ALLOW_ORIGINS=http://localhost:3000
# When true, unauthenticated visitors get read-only (GET) access; everything that starts a
# session, calls the agent, or reads the audit log still needs a real token regardless.
PUBLIC_DEMO_MODE=true
# Per-client-IP requests/minute; in-memory and per-process (see docs/THREAT_MODEL.md). 0 disables it.
RATE_LIMIT_PER_MINUTE=120

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- docker compose only ---
# Postgres/TimescaleDB credentials for the `db` service (compose ignores these if you don't use
# `docker compose up`; local dev defaults to SQLite above).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=sentinel
# The one account `docker compose up` provisions via the `bootstrap` service (scripts/tasks.py
# create-user under the hood). Required — compose refuses to start without it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-real-deployments
